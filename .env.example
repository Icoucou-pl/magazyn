# PRZYKŁAD - skopiuj jako .env i wpisz prawdziwe wartości
# .env nigdy nie idzie do GitHuba!

# Baza danych - osobne pola żeby nie URL-encodować hasła
DB_HOST=localhost
DB_PORT=5432
DB_NAME=magazyn
DB_USER=postgres
DB_PASSWORD=twoje_haslo

# CORS - adresy z których frontend może się łączyć
ALLOWED_ORIGINS=http://localhost:3000

# Domyślny lead time
DEFAULT_LEAD_TIME_DAYS=90

# Klucz do podpisywania logowań (JWT). W produkcji MUSI być stały (zmienna w Railway) —
# bez niego każdy deploy generuje nowy klucz i wylogowuje wszystkich.
# Wygeneruj np.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
