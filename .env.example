# PRZYKŁAD - skopiuj jako .env i wpisz prawdziwe wartości
# .env nigdy nie idzie do GitHuba!

# Baza danych - osobne pola żeby nie URL-encodować hasła
DB_HOST=localhost
DB_PORT=5432
DB_NAME=magazyn
DB_USER=postgres
DB_PASSWORD=twoje_haslo

# CORS - adresy z których frontend może się łączyć
ALLOWED_ORIGINS=http://localhost:3000

# Domyślny lead time
DEFAULT_LEAD_TIME_DAYS=90

# Klucz do podpisywania logowań (JWT). W produkcji MUSI być stały (zmienna w Railway) —
# bez niego każdy deploy generuje nowy klucz i wylogowuje wszystkich.
# Wygeneruj np.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Zakładka „Pliki” — Supabase Storage, bucket magazyn-pliki (instrukcja: sql/2026-10-pliki.sql).
# Techniczne konto z dostępem tylko do tego bucketu. Bez tych zmiennych zakładka działa bez wgrywania,
# a karta kontenera zapisuje załączniki po staremu do bazy.
PLIKI_STORAGE_EMAIL=
PLIKI_STORAGE_PASSWORD=
# Adres projektu i klucz anon — domyślnie te same co dla etykiet dropów (DROPY_STORAGE_URL / _ANON_KEY).
# PLIKI_STORAGE_URL=https://<projekt>.supabase.co
# PLIKI_STORAGE_ANON_KEY=
